<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- TV features (not required so the app also runs on phones) -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AraToons">

        <!-- Required by Chromium (WebView) for GMS version lookup.
             Must match the play-services-basement version bundled with the
             system WebView (18.1.0 -> 12451000 for WebView 137). -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="12451000" />

        <!-- Headless WebView stream extractor: isolated in its own process
             so a FATAL Chromium init on vendor System WebView kills only
             this process, not the app. -->
        <service
            android:name=".data.WebViewExtractService"
            android:exported="false"
            android:process=":wv" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|screenLayout|smallestScreenSize"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.AraToons"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
